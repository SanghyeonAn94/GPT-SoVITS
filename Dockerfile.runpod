# ── Stage 1: pull base model assets from S3 (baked into the image so a cold
#    worker never has to fetch them at runtime; per-character checkpoints are
#    unrelated and still fetched lazily at inference/training time) ─────────
FROM amazon/aws-cli:2.15.0 AS asset-fetcher
ARG AWS_ACCESS_KEY_ID
ARG AWS_SECRET_ACCESS_KEY
ARG AWS_SESSION_TOKEN
ARG AWS_DEFAULT_REGION=ap-northeast-2
ARG GPTSOVITS_PRETRAINED_S3=s3://shiftup-enterprise-ai-service/voice/model_registry
ENV AWS_ACCESS_KEY_ID=${AWS_ACCESS_KEY_ID} \
    AWS_SECRET_ACCESS_KEY=${AWS_SECRET_ACCESS_KEY} \
    AWS_SESSION_TOKEN=${AWS_SESSION_TOKEN} \
    AWS_DEFAULT_REGION=${AWS_DEFAULT_REGION}

RUN aws s3 sync "${GPTSOVITS_PRETRAINED_S3}/GPT-SoVITS/GPT_SoVITS/pretrained_models/" /assets/pretrained_models/ && \
    echo "baked at build time" > /assets/pretrained_models/.s3_synced && \
    aws s3 sync "${GPTSOVITS_PRETRAINED_S3}/base/faster-whisper-large-v3/" /assets/asr/faster-whisper-large-v3/ && \
    echo "baked at build time" > /assets/asr/faster-whisper-large-v3/.s3_synced && \
    aws s3 sync "${GPTSOVITS_PRETRAINED_S3}/GPT-SoVITS/tools/uvr5/uvr5_weights/" /assets/uvr5_weights/ && \
    echo "baked at build time" > /assets/uvr5_weights/.s3_synced

# ── Stage 2: runtime image ───────────────────────────────────────────────
FROM nvidia/cuda:12.8.1-cudnn-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    GPTSOVITS_BASE_DIR=/app/GPT-SoVITS \
    GPTSOVITS_VOLUME_PATH=/runpod-volume/gpt-sovits \
    GPTSOVITS_WORK_ROOT=/tmp/work \
    GPTSOVITS_ASR_PATH=/runpod-volume/gpt-sovits/asr/faster-whisper-large-v3 \
    GPTSOVITS_UVR5_WEIGHTS=/runpod-volume/gpt-sovits/uvr5_weights \
    GPTSOVITS_MODEL_REGISTRY_S3=s3://shiftup-enterprise-ai-service/voice/model_registry/GPT-SoVITS \
    AWS_DEFAULT_REGION=ap-northeast-2

RUN apt-get update && apt-get install -y --no-install-recommends \
        software-properties-common ca-certificates && \
    add-apt-repository ppa:deadsnakes/ppa && \
    apt-get update && apt-get install -y --no-install-recommends \
        python3.11 python3.11-dev python3.11-distutils \
        git wget curl ffmpeg libsndfile1 build-essential && \
    rm -rf /var/lib/apt/lists/*

RUN curl -sS https://bootstrap.pypa.io/get-pip.py | python3.11 && \
    update-alternatives --install /usr/bin/python python /usr/bin/python3.11 1 && \
    update-alternatives --install /usr/bin/pip pip /usr/local/bin/pip3.11 1

RUN pip install --no-cache-dir \
        torch==2.7.1 torchaudio==2.7.1 \
        --index-url https://download.pytorch.org/whl/cu128

WORKDIR /app/GPT-SoVITS

COPY requirements.txt /tmp/gpt-sovits-requirements.txt
RUN pip install --no-cache-dir -r /tmp/gpt-sovits-requirements.txt

RUN pip install --no-cache-dir \
        "faster-whisper>=1.1.0" \
        soundfile \
        BS-RoFormer \
        boto3 \
        httpx \
        runpod

RUN python -c "import nltk; nltk.download('averaged_perceptron_tagger_eng'); nltk.download('punkt')"

COPY . /app/GPT-SoVITS

COPY --from=asset-fetcher /assets/pretrained_models GPT_SoVITS/pretrained_models
COPY --from=asset-fetcher /assets/asr/faster-whisper-large-v3 tools/asr/models/faster-whisper-large-v3
COPY --from=asset-fetcher /assets/uvr5_weights tools/uvr5/uvr5_weights

RUN echo '#!/bin/bash\n\
set -e\n\
cd /app/GPT-SoVITS\n\
\n\
VOL=/runpod-volume/gpt-sovits\n\
S3_BASE=${GPTSOVITS_PRETRAINED_S3:-s3://shiftup-enterprise-ai-service/voice/model_registry}\n\
\n\
if [ -d "$VOL/pretrained_models" ]; then\n\
    rm -rf GPT_SoVITS/pretrained_models\n\
    ln -sfn "$VOL/pretrained_models" GPT_SoVITS/pretrained_models\n\
elif [ ! -f "GPT_SoVITS/pretrained_models/.s3_synced" ]; then\n\
    echo "Syncing pretrained_models from S3..."\n\
    python -c "from app.s3_utils import ensure_local; ensure_local('"'"'GPT_SoVITS/pretrained_models'"'"', '"'"'${S3_BASE}/GPT-SoVITS/GPT_SoVITS/pretrained_models/'"'"')"\n\
fi\n\
\n\
if [ -d "$VOL/asr" ]; then\n\
    rm -rf tools/asr/models\n\
    ln -sfn "$VOL/asr" tools/asr/models\n\
elif [ ! -f "tools/asr/models/faster-whisper-large-v3/.s3_synced" ]; then\n\
    echo "Syncing ASR model from S3..."\n\
    python -c "from app.s3_utils import ensure_local; ensure_local('"'"'tools/asr/models/faster-whisper-large-v3'"'"', '"'"'${S3_BASE}/base/faster-whisper-large-v3/'"'"')"\n\
fi\n\
\n\
if [ -d "$VOL/uvr5_weights" ]; then\n\
    rm -rf tools/uvr5/uvr5_weights\n\
    ln -sfn "$VOL/uvr5_weights" tools/uvr5/uvr5_weights\n\
elif [ ! -f "tools/uvr5/uvr5_weights/.s3_synced" ]; then\n\
    echo "Syncing UVR5 weights from S3..."\n\
    python -c "from app.s3_utils import ensure_local; ensure_local('"'"'tools/uvr5/uvr5_weights'"'"', '"'"'${S3_BASE}/GPT-SoVITS/tools/uvr5/uvr5_weights/'"'"')"\n\
fi\n\
\n\
mkdir -p "$GPTSOVITS_WORK_ROOT"\n\
\n\
exec "$@"\n\
' > /entrypoint.sh && chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
CMD ["python", "-u", "-m", "app.handler"]
